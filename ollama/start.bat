@echo off
title Ollama Server (RTX 3060 6GB Optimized)
echo ==========================================
echo  Запуск Ollama с настройками для 6GB VRAM
echo ==========================================
echo.

:: Ограничиваем контекст до 2048 токенов (экономит ~600MB VRAM)
set OLLAMA_NUM_CTX=2048

:: Принудительно загружаем все слои модели на GPU
set OLLAMA_NUM_GPU=999

:: Оставляем модель в VRAM на 10 минут после запроса (баланс скорость/память)
set OLLAMA_KEEP_ALIVE=10m

:: Запускаем сервер (лог будет выводиться в это окно)
echo ?? Запуск сервера на http://localhost:11434 ...
echo ?? Не закрывайте это окно во время генерации корпуса.
echo.
ollama serve
pause